# Copy this file to .env and fill in real values: cp .env.example .env
# Never commit .env with real secrets.

# Django
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ENV=dev
HOST=http://localhost:8000
WEB_CONCURRENCY=2

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=your-db-name
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Email (SMTP)
EMAIL_HOST_USER=you@example.com
EMAIL_HOST=smtp.example.com
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_PORT=587
EMAIL_USE_SSL=True
EMAIL_CLIENT=your-email-client-name

# Stripe / Flask API
STRIPE_FLASK_API=https://your-flask-api.example.com/stripe
STRIPE_PASS=your-stripe-pass
STRIPE_EMAIL=you@example.com
STRIPE_PUBLIC=your-stripe-public-key
STRIPE_PRIVATE=your-stripe-private-key
STRIPE_USER=your-stripe-user

# Landing pages
ROHAN_KARISMA_PAGE=https://example.com/rohan-karisma
DIGITALREALTY_PAGE=https://example.com/digitalrealty
